  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-30.67868,\"yPos\":-1021.15491},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Listen\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-237.437714,\"yPos\":-45.9131},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Review
    Footage\",\"parentUIDs\":[42,147,160,345],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":970.153137,\"yPos\":312.871552},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ask
    Questions \",\"parentUIDs\":[147],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-357.304962,\"yPos\":365.2053},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Judge\\n\",\"parentUIDs\":[194,332],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-631.6724,\"yPos\":860.5204},\"ID\":26,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Death\",\"parentUIDs\":[25,328],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":40}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1179.16113,\"yPos\":373.526581},\"ID\":37,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Those
    people had families! Why did you do it?\",\"parentUIDs\":[36],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":45}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1608.835,\"yPos\":539.194946},\"ID\":38,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wait!
    You used a fork, not a spoon. Why?\",\"parentUIDs\":[36],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":47}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":2136.186,\"yPos\":601.5333},\"ID\":39,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Since
    when do dogs like ice cream?\",\"parentUIDs\":[46],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":52}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1977.14648,\"yPos\":165.1929},\"ID\":51,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Romance\",\"parentUIDs\":[158,261],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":388.462463,\"yPos\":217.739532},\"ID\":53,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    free after this?\",\"parentUIDs\":[52],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":111}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":634.8236,\"yPos\":328.697479},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    are your hobbies? It's important for the case\",\"parentUIDs\":[52],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":485.16037,\"yPos\":840.192749},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Stilll.
    Wanna hang out?\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":297.1679,\"yPos\":1185.191},\"ID\":62,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    can give you whatever you want!\",\"parentUIDs\":[60],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":101}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":745.165955,\"yPos\":1176.86829},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Look
    suggestively\",\"parentUIDs\":[60],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":67}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":300.502136,\"yPos\":1500.51721},\"ID\":66,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Flirt
    more\",\"parentUIDs\":[65],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":465.495544,\"yPos\":2163.068},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"By
    the way, did you do it? I like the bad boys.\",\"parentUIDs\":[71],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":77}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":75.15541,\"yPos\":2340.67847},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Has
    anyone ever told you your eyes look like moss?\\r\",\"parentUIDs\":[74,103,113,129],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":161}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1086.66211,\"yPos\":3994.254},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Surprise!
    I tricked you!\",\"parentUIDs\":[74],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":677.06366,\"yPos\":2542.5835},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Talk
    dirty\",\"parentUIDs\":[77],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":208}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":670.9909,\"yPos\":3015.43433},\"ID\":83,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Maybe
    not to jail... But what about home arrest at my place?\",\"parentUIDs\":[82],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":94}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":247.3315,\"yPos\":3791.466},\"ID\":92,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Take
    offer\",\"parentUIDs\":[91],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":98}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":464.860779,\"yPos\":3883.61841},\"ID\":93,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Come
    to your senses\",\"parentUIDs\":[91],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":200}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":206.09465,\"yPos\":4391.42041},\"ID\":97,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"End
